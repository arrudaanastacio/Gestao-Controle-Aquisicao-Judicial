# Copie este arquivo para ".env" e preencha com seus dados de acesso ao GsnetCompras.
# O arquivo .env fica SO na sua maquina (nao vai para o GitHub).
GSNET_USUARIO=coloque-seu-usuario-aqui
GSNET_SENHA=coloque-sua-senha-aqui

# Caminho do Chrome (ja detectado; so mude se necessario)
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Filtros do Relatorio Estrategico de Empenhos (mudam so se necessario)
# Unidade Institucional: Gabinete do Coordenador - CAF
GSNET_UNIDADE=Gabinete do Coordenador - CAF
# Periodo inicio (mes/ano). O fim e sempre o mes atual.
GSNET_PERIODO_INICIO=01/2023

# (Opcional) Pasta onde salvar o relatorio antes de importar.
# Se nao preencher, usa a subpasta "downloads" ao lado do robo.
# PASTA_DOWNLOAD=

# (Opcional) Caminho do banco e do backend. Se nao preencher, o robo usa
# automaticamente a pasta "..\backend" ao lado dele (funciona em teste e
# em producao sem mudar nada).
# BANCO=
# BACKEND_DIR=
